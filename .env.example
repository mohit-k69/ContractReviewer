# SESSION_SECRET: REQUIRED in production. Signs the HttpOnly session cookie (use a long random string).
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# GEMINI_API_KEY: Optional. Enables Gemini for contract understanding.
# Without it the built-in deterministic engine is used (the app still works end to end).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_CONTRACT_MODEL: Optional model override.
# GEMINI_CONTRACT_MODEL="gemini-3.8-flash"

# CLAMAV_HOST / CLAMAV_PORT: Optional. Point at a real ClamAV daemon. If unset, an embedded demo scanner is used.
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
