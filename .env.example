# SESSION_SECRET: REQUIRED in production. Signs the HttpOnly session cookie (use a long random string).
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# GEMINI_API_KEY: Optional. Enables Gemini for contract understanding.
# Without it the built-in deterministic engine is used (the app still works end to end).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_CONTRACT_MODEL: Optional model override.
# GEMINI_CONTRACT_MODEL="gemini-3.8-flash"

# Antivirus (REQUIRED for any real deployment). Without one, uploads are reported as UNAVAILABLE and are NOT analysed.
# Production: the HTTPS ClamAV scanning service in scanner-service/ (Google Cloud Run). Server-side only; never VITE_*.
# CLAMAV_SCAN_URL="https://<your-scanner>.run.app/scan"
# CLAMAV_SCAN_TOKEN="the same secret the scanning service uses (SCAN_TOKEN)"
# Self-hosted alternative: a real ClamAV daemon over TCP.
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"
# Local development / tests ONLY: the embedded demo scanner. It is NOT antivirus and is refused on Vercel and in
# production. (`npm run dev` enables it for you.)
# ALLOW_DEMO_SCANNER="1"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
