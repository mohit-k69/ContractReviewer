# SESSION_SECRET: REQUIRED in production. Signs the HttpOnly session cookie (use a long random string).
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# GEMINI_API_KEY: Optional. Enables Gemini for contract understanding.
# Without it the built-in deterministic engine is used (the app still works end to end).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_CONTRACT_MODEL: Optional model override.
# GEMINI_CONTRACT_MODEL="gemini-3.8-flash"

# Antivirus is OPTIONAL. With none configured, the built-in security checks decide and uploads are labelled
# "basic checks only; full antivirus scanning was not performed".
# ANTIVIRUS_POLICY: "optional" (default) or "required" (a genuine antivirus scan is then mandatory).
# ANTIVIRUS_POLICY="optional"
# If you configure an antivirus it is enforced and fails closed. Server-side only; never VITE_*.
# CLAMAV_SCAN_URL="https://<your-scanner>.run.app/scan"   (see scanner-service/, not required for the MVP)
# CLAMAV_SCAN_TOKEN="the same secret the scanning service uses (SCAN_TOKEN)"
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
